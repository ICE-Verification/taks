<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مساعد التقارير اليومية | عزام</title>
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --bg: #f8fafc;
            --card: #ffffff;
            --text: #1e293b;
            --border: #e2e8f0;
            --whatsapp: #25D366;
            --whatsapp-hover: #128C7E;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
        }
        h1 { text-align: center; color: var(--primary); margin-bottom: 30px; }
        .container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .card {
            background: var(--card);
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }
        h2 { font-size: 1.2rem; margin-top: 0; border-bottom: 2px solid var(--border); padding-bottom: 10px; }
        
        /* Timer Styles */
        .timer-display {
            font-size: 3rem;
            font-weight: bold;
            text-align: center;
            margin: 20px 0;
            color: var(--primary);
        }
        .btn-group { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
        button {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1rem;
            transition: 0.2s;
        }
        button:hover { background-color: var(--primary-hover); }
        .btn-danger { background-color: #ef4444; }
        .btn-danger:hover { background-color: #dc2626; }
        .btn-success { background-color: #10b981; width: 100%; margin-top: 20px; font-size: 1.1rem; padding: 15px;}
        .btn-success:hover { background-color: #059669; }
        .btn-whatsapp { background-color: var(--whatsapp); width: 100%; margin-top: 10px; font-size: 1.1rem; padding: 15px; font-weight: bold; }
        .btn-whatsapp:hover { background-color: var(--whatsapp-hover); }

        /* Inputs & Textareas */
        input[type="text"], textarea {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            margin-bottom: 15px;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-family: inherit;
            box-sizing: border-box;
            resize: vertical;
        }
        textarea { height: 80px; }
        
        /* Log List */
        .log-list {
            list-style: none;
            padding: 0;
            max-height: 250px;
            overflow-y: auto;
        }
        .log-list li {
            background: var(--bg);
            padding: 10px;
            margin-bottom: 8px;
            border-radius: 6px;
            border-right: 4px solid var(--primary);
            font-size: 0.9rem;
            display: flex;
            justify-content: space-between;
        }
        .delete-log {
            color: #ef4444; cursor: pointer; font-weight: bold; padding: 0 5px;
        }

        @media (max-width: 768px) {
            .container { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <h1>نظام تقارير العمل اليومية</h1>

    <div class="container">
        <!-- القسم الأيسر: المؤقت وسجل الساعات -->
        <div class="card">
            <h2>⏱️ مؤقت الإنجاز (كل 60 دقيقة)</h2>
            <div class="timer-display" id="timer">60:00</div>
            <div class="btn-group">
                <button onclick="startTimer()">▶️ بدء</button>
                <button onclick="pauseTimer()">⏸️ إيقاف</button>
                <button onclick="resetTimer()" class="btn-danger">🔄 إعادة ضبط</button>
                <button onclick="testSound()" style="background-color: #64748b;">🔊 تجربة الصوت</button>
            </div>

            <h2 style="margin-top: 30px;">📝 مسودة الإنجاز الساعي</h2>
            <div style="display: flex; gap: 10px;">
                <input type="text" id="log-input" placeholder="ماذا أنجزت في هذه الساعة؟">
                <button onclick="addLog()" style="margin-bottom: 15px;">إضافة</button>
            </div>
            <ul class="log-list" id="log-list"></ul>
            <button onclick="clearLogs()" class="btn-danger" style="width: 100%; margin-top: 10px; font-size: 0.9rem;">🗑️ مسح كل المسودات</button>
        </div>

        <!-- القسم الأيمن: التقرير النهائي -->
        <div class="card">
            <h2>📋 التقرير النهائي</h2>
            
            <label>1- المهام المنجزة:</label>
            <textarea id="task-done" placeholder="الأعمال التي تم الانتهاء منها..."></textarea>

            <label>2- المهام قيد التنفيذ (مع نسبة الإنجاز):</label>
            <textarea id="task-progress" placeholder="مثال: تجهيز العرض التقديمي (70%)..."></textarea>

            <label>3- المشكلات والعقبات:</label>
            <textarea id="task-issues" placeholder="صعوبات أثرت على سير العمل..."></textarea>

            <label>4- خطة اليوم التالي:</label>
            <textarea id="task-next" placeholder="أولويات العمل للغد..."></textarea>

            <button onclick="generateAndCopyReport()" class="btn-success">📋 نسخ التقرير</button>
            <button onclick="sendViaWhatsApp()" class="btn-whatsapp">💬 إرسال التقرير عبر واتساب</button>
        </div>
    </div>

    <script>
        // --- إعدادات الصوت ---
        // استخدام ملف صوتي مجاني متاح عبر الإنترنت للتنبيه
        const alarmSound = new Audio('https://actions.google.com/sounds/v1/alarms/beep_short.ogg');
        
        function testSound() {
            alarmSound.currentTime = 0;
            alarmSound.play().catch(e => alert("يجب التفاعل مع الصفحة أولاً لتشغيل الصوت."));
        }

        // --- إعدادات المؤقت ---
        let timeLeft = 3600; 
        let timerInterval;
        let isRunning = false;

        const timerDisplay = document.getElementById('timer');

        function updateTimerDisplay() {
            let m = Math.floor(timeLeft / 60).toString().padStart(2, '0');
            let s = (timeLeft % 60).toString().padStart(2, '0');
            timerDisplay.textContent = `${m}:${s}`;
        }

        function startTimer() {
            if (!isRunning) {
                // تشغيل صامت للصوت لتجنب حظر المتصفحات للتشغيل التلقائي لاحقاً
                alarmSound.play().then(() => {
                    alarmSound.pause();
                    alarmSound.currentTime = 0;
                }).catch(e => console.log("تحتاج لتشغيل الصوت يدوياً أول مرة"));

                isRunning = true;
                timerInterval = setInterval(() => {
                    if (timeLeft > 0) {
                        timeLeft--;
                        updateTimerDisplay();
                    } else {
                        clearInterval(timerInterval);
                        isRunning = false;
                        alarmSound.play(); // رنين المنبه
                        alert("⏰ حان وقت تسجيل إنجازات هذه الساعة!");
                        timeLeft = 3600;
                        updateTimerDisplay();
                    }
                }, 1000);
            }
        }

        function pauseTimer() {
            clearInterval(timerInterval);
            isRunning = false;
        }

        function resetTimer() {
            clearInterval(timerInterval);
            isRunning = false;
            timeLeft = 3600;
            updateTimerDisplay();
        }

        // --- إعدادات المسودات ---
        function addLog() {
            const input = document.getElementById('log-input');
            const text = input.value.trim();
            if (text === "") return;

            const now = new Date();
            const timeString = now.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
            
            const logs = JSON.parse(localStorage.getItem('workLogs') || '[]');
            logs.push({ time: timeString, text: text });
            localStorage.setItem('workLogs', JSON.stringify(logs));
            
            input.value = "";
            renderLogs();
        }

        function renderLogs() {
            const list = document.getElementById('log-list');
            list.innerHTML = "";
            const logs = JSON.parse(localStorage.getItem('workLogs') || '[]');
            
            logs.forEach((log, index) => {
                const li = document.createElement('li');
                li.innerHTML = `<span><b>[${log.time}]</b> ${log.text}</span> <span class="delete-log" onclick="deleteLog(${index})">×</span>`;
                list.appendChild(li);
            });
        }

        function deleteLog(index) {
            const logs = JSON.parse(localStorage.getItem('workLogs') || '[]');
            logs.splice(index, 1);
            localStorage.setItem('workLogs', JSON.stringify(logs));
            renderLogs();
        }

        function clearLogs() {
            if(confirm("هل أنت متأكد من مسح جميع مسودات اليوم؟")) {
                localStorage.removeItem('workLogs');
                renderLogs();
            }
        }

        // --- الحفظ التلقائي للنصوص ---
        const textareas = ['task-done', 'task-progress', 'task-issues', 'task-next'];
        
        textareas.forEach(id => {
            const el = document.getElementById(id);
            if (localStorage.getItem(id)) el.value = localStorage.getItem(id);
            el.addEventListener('input', () => localStorage.setItem(id, el.value));
        });

        // --- تجميع التقرير ---
        function buildReportString() {
            const done = document.getElementById('task-done').value;
            const progress = document.getElementById('task-progress').value;
            const issues = document.getElementById('task-issues').value;
            const next = document.getElementById('task-next').value;
            
            const logs = JSON.parse(localStorage.getItem('workLogs') || '[]');
            let logsText = "";
            if (logs.length > 0) {
                logsText = "\n\n---\n*تفاصيل المتابعة الساعية:*\n" + logs.map(l => `- [${l.time}] ${l.text}`).join('\n');
            }

            return `*تقرير العمل اليومي*\n\n*1- المهام المنجزة:*\n${done || "لا يوجد"}\n\n*2- المهام قيد التنفيذ:*\n${progress || "لا يوجد"}\n\n*3- المشكلات والعقبات:*\n${issues || "لا يوجد"}\n\n*4- خطة اليوم التالي:*\n${next || "لا يوجد"}${logsText}`;
        }

        function generateAndCopyReport() {
            const finalReport = buildReportString();
            navigator.clipboard.writeText(finalReport).then(() => {
                alert("✅ تم نسخ التقرير بنجاح!");
            });
        }

        // --- إرسال عبر واتساب ---
        function sendViaWhatsApp() {
            const finalReport = buildReportString();
            // استخدام رابط واتساب العالمي (يعمل على المتصفح والتطبيق)
            const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(finalReport)}`;
            window.open(whatsappUrl, '_blank');
        }

        renderLogs();
    </script>
</body>
</html>
